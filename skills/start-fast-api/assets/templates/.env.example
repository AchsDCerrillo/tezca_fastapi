# Copy to .env.dev / .env.prod and fill in. Select the file with ENVIRONMENT=dev|prod (local = defaults in config.py).
ENVIRONMENT=dev
APP_NAME={{PROJECT_NAME}}
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO

# Database (inside docker compose DATABASE_HOST is overridden to "db")
DATABASE_DRIVER={{DATABASE_DRIVER}}
DATABASE_HOST=localhost
DATABASE_PORT={{DATABASE_PORT}}
DATABASE_USER={{DATABASE_USER}}
DATABASE_PASSWORD={{DATABASE_PASSWORD}}
DATABASE_NAME={{DATABASE_NAME}}
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Run `alembic upgrade head` in the container entrypoint (single-container deploys)
RUN_MIGRATIONS=false

# Integrations (added by add-core)
